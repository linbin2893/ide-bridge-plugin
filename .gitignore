# ---- Gradle ----
.gradle/
build/
# wrapper 的 jar 必须入库，否则 clone 下来跑不了 ./gradlew
# 用 ** 而非锚定路径：Gradle 工程已下移到 idea-plugin/，写死 gradle/ 开头会匹配不到
!**/gradle/wrapper/gradle-wrapper.jar

# Kotlin 2.x 增量编译的会话目录，纯本地状态
.kotlin/

# intellijPlatform 2.x 下载并解压的 IDE 发行版与插件产物，体积大且完全可重建
.intellijPlatform/

# ---- Node / pnpm ----
# dsh-plugin 经 junction 挂载为 DSH profile 的 pnpm workspace 成员，
# 在 ~/.dsh/profiles/web/ 下跑 pnpm install 会顺着 junction 在本仓库里生成 node_modules
node_modules/
.pnpm-debug.log*

# ---- IntelliJ IDEA ----
# 本项目的 .idea 全部由 Gradle 导入自动生成，重新 Reload 即可重建；
# 其中 workspace.xml 还带本机路径与窗口布局，入库只会制造无谓冲突
.idea/
*.iml
*.ipr
*.iws
out/

# 本机覆盖配置（SDK 路径等），不应共享
local.properties

# ---- OS / 编辑器杂项 ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
